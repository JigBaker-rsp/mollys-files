{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mollys-files.local/schemas/lore_secret.schema.json",
  "title": "Molly's Files embedded lore secret",
  "type": "object",
  "required": [
    "id",
    "universe_id",
    "version",
    "status",
    "public_legend",
    "historical_truth",
    "auguste_discovery",
    "narrative_function",
    "immutable_rules"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "universe_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "version": {"type": "string"},
    "status": {"enum": ["draft", "specified", "validated"]},
    "public_legend": {"type": "string", "minLength": 1},
    "historical_truth": {
      "type": "object",
      "required": ["year", "partners", "agreement", "rupture", "fraud", "consequence"]
    },
    "auguste_discovery": {
      "type": "object",
      "required": ["trigger", "confirmed_by", "planned_announcement"]
    },
    "narrative_function": {
      "type": "object",
      "required": ["primary_mystery", "embedded_story", "complexity_limits", "act_progression"]
    },
    "immutable_rules": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}

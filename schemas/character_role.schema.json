{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mollys-files.local/schemas/character_role.schema.json",
  "title": "Molly's Files character role",
  "type": "object",
  "required": [
    "id",
    "canonical_name",
    "role_type",
    "availability",
    "culprit",
    "public_identity",
    "casting",
    "private_truth",
    "gameplay",
    "relationships",
    "act_revelations",
    "finale"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^role_[0-9]{2}$"},
    "canonical_name": {"type": "string", "minLength": 1},
    "role_type": {"enum": ["required", "optional"]},
    "availability": {
      "type": "object",
      "required": ["compact_4_players", "standard_6_players", "extended_8_players"],
      "additionalProperties": {"enum": ["active", "converted_to_npc_evidence", "converted_to_collective_evidence", "not_used"]}
    },
    "culprit": {"type": "boolean"},
    "public_identity": {
      "type": "object",
      "required": ["title", "description", "public_relation_to_victim", "apparent_motive", "costume_cues"]
    },
    "casting": {
      "type": "object",
      "required": ["difficulty", "play_style", "recommended_for", "organizer_friendly", "culprit_opt_in_recommended"]
    },
    "private_truth": {
      "type": "object",
      "required": ["relationship_to_victim", "secret", "independent_secret", "claimed_alibi", "actual_timeline", "knowledge_limits"]
    },
    "gameplay": {
      "type": "object",
      "required": ["private_objective", "secondary_objective", "reason_to_lie", "suspect_axes", "allowed_lies", "forbidden_inventions", "known_facts", "documents_held"]
    },
    "relationships": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["target_role_id", "public", "private"],
        "properties": {
          "target_role_id": {"type": "string", "pattern": "^role_[0-9]{2}$"},
          "public": {"type": "string", "minLength": 1},
          "private": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "act_revelations": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["act", "class", "content", "fallback"],
        "properties": {
          "act": {"type": "integer", "minimum": 1, "maximum": 3},
          "class": {"enum": ["free", "conditional", "mandatory"]},
          "trigger": {"type": "string"},
          "deadline": {"type": "string"},
          "content": {"type": "string", "minLength": 1},
          "fallback": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"class": {"const": "conditional"}}},
            "then": {"required": ["trigger"]}
          }
        ],
        "additionalProperties": false
      }
    },
    "variant_transfer": {"type": "object"},
    "finale": {"type": "object"}
  },
  "additionalProperties": false
}

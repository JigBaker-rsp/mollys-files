  "victim": {
    "id": "npc_victim",
    "canonical_name": "Auguste de Valleroy",
    "age": 62,
    "public_identity": "Propriétaire du Palace Belladone et héritier d'une ancienne famille alpine.",
    "public_reputation": "Hôte brillant, mécène exigeant et négociateur redouté.",
    "private_truth": "Il utilisait les dettes, les secrets et les dépendances de son entourage pour conserver le contrôle du palace.",
    "final_intention": "Révéler au petit déjeuner une fraude successorale, écarter l'héritier désigné et préparer la vente du palace.",
    "death_contract": {
      "method": "Substitution de ses gouttes digestives habituelles par une préparation toxique fictive à effet différé.",
      "safety_note": "Le jeu ne décrit ni substance réelle exploitable, ni dosage, ni méthode de préparation.",
      "poisoning_window": "Avant la fin du gala, bien avant l'entrée de la victime dans son bureau.",
      "locked_room_explanation": "La victime s'est enfermée elle-même après avoir absorbé la préparation ; personne n'avait besoin d'entrer dans le bureau au moment de la mort."
    }
  },

{
  "version": "0.5.0",
  "pipeline": [
    {
      "step": 1,
      "id": "validate_order",
      "blocking": true
    },
    {
      "step": 2,
      "id": "load_offer_universe_gameplay_and_timeline",
      "blocking": true,
      "outputs": [
        "universe_contract",
        "canonical_timeline",
        "variant_delivery_map"
      ]
    },
    {
      "step": 3,
      "id": "resolve_variant",
      "blocking": true,
      "outputs": [
        "selected_variant_id",
        "selected_gameplay_contract",
        "selected_role_set",
        "selected_duration_profile",
        "selected_timeline_delivery"
      ]
    },
    {
      "step": 4,
      "id": "transfer_removed_role_information",
      "blocking": true,
      "applies_when": "selected_variant_removes_roles"
    },
    {
      "step": 5,
      "id": "assign_characters",
      "blocking": true
    },
    {
      "step": 6,
      "id": "apply_personalization",
      "blocking": true
    },
    {
      "step": 7,
      "id": "build_autonomous_session_package",
      "blocking": true
    },
    {
      "step": 8,
      "id": "render_documents",
      "blocking": true
    },
    {
      "step": 9,
      "id": "run_content_validation",
      "blocking": true
    },
    {
      "step": 10,
      "id": "run_timeline_validation",
      "blocking": true
    },
    {
      "step": 11,
      "id": "run_autonomy_validation",
      "blocking": true
    },
    {
      "step": 12,
      "id": "run_variant_validation",
      "blocking": true
    },
    {
      "step": 13,
      "id": "run_file_validation",
      "blocking": true
    },
    {
      "step": 14,
      "id": "package_delivery",
      "blocking": true
    },
    {
      "step": 15,
      "id": "deliver_or_fulfill",
      "blocking": true
    },
    {
      "step": 16,
      "id": "schedule_data_deletion",
      "blocking": false
    }
  ],
  "failure_policy": {
    "automatic_retries": 2,
    "deliver_partial_output": false,
    "notify_operator_after_final_failure": true,
    "preserve_failure_diagnostics_without_customer_content": true
  },
  "reproducibility": {
    "store_version_ids": true,
    "store_generation_seed": true,
    "store_validation_report": true,
    "store_gameplay_contract_version": true,
    "store_variant_id": true,
    "store_role_transfer_map": true,
    "store_canonical_timeline_version": true,
    "store_variant_timeline_delivery_version": true
  }
}
